{
  // Without this file, `wrangler deploy` detects "Framework: Vite", generates its own config,
  // installs @cloudflare/vite-plugin and RE-RUNS `npm run build` itself. That second run
  // overwrites the prerendered HTML the first build just produced, and it builds
  // src/entry-server.tsx in a *client* environment, where `node:stream` is externalized and the
  // SSR entry cannot compile. The deploy then ships a client-only dist and the prerender looks
  // like it failed, when in fact it had already succeeded minutes earlier in the same log.
  //
  // With a config present, wrangler uploads ./dist as-is and runs no build of its own.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "al-primo-piano",
  "compatibility_date": "2026-08-31",
  "assets": {
    "directory": "./dist",
    // Prerendered routes are real files (dist/menu/index.html), so they are served directly.
    // This only governs URLs with no matching file, which the client router turns into the 404.
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
